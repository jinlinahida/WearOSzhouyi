<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="140dp"
    android:height="140dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- 0. 柔和背光微晕 -->
    <path
        android:pathData="M60,60m-52,0a52,52 0 1,0 104,0a52,52 0 1,0 -104,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="52"
                android:type="radial">
                <item android:offset="0.0" android:color="#26D4AF37" />
                <item android:offset="0.7" android:color="#0CD4AF37" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 1. 底部接地微投影 -->
    <path
        android:pathData="M30,103 C42,107 78,107 92,103 C99,101 88,111 60,111 C32,111 23,101 30,103 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="106"
                android:gradientRadius="35"
                android:type="radial">
                <item android:offset="0.0" android:color="#4D000000" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 木鱼实体躯干：饱满浑圆的红木/金丝楠木实体渐变体 -->
    <path
        android:pathData="M24,67 C20,41 38,18 64,18 C90,18 107,38 107,64 C107,88 88,105 62,105 C42,105 26,89 24,67 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="18"
                android:endX="78"
                android:endY="105"
                android:type="linear">
                <!-- 顶部高光木色到下部醇厚暗红木质感 -->
                <item android:offset="0.0" android:color="#5A3A22" />
                <item android:offset="0.25" android:color="#462B17" />
                <item android:offset="0.65" android:color="#321D0E" />
                <item android:offset="1.0" android:color="#211208" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. 木鱼背部丰满立体高光弧面（3D球形光泽） -->
    <path
        android:pathData="M28,62 C26,43 40,23 62,22 C84,21 98,36 100,56 C93,38 78,28 60,28 C40,28 29,44 28,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60"
                android:startY="20"
                android:endX="60"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#4D9C683B" />
                <item android:offset="0.6" android:color="#1A9C683B" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. 鱼身雕刻祥云暗纹（实体内凹木刻立体感） -->
    <!-- 祥云凹槽暗部 -->
    <path
        android:pathData="M42,35 C52,28 68,28 78,36"
        android:strokeColor="#180C05"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 祥云边缘受光微亮线 -->
    <path
        android:pathData="M43,36 C53,29 67,29 77,37"
        android:strokeColor="#40C2945D"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 5. 实体鱼眼雕刻（内凹圆窝 + 浮雕内珠） -->
    <!-- 鱼眼外凹窝阴影 -->
    <path
        android:pathData="M46,49m-8,0a8,8 0 1,0 16,0a8,8 0 1,0 -16,0"
        android:fillColor="#1B0E07" />
    <!-- 鱼眼窝高光边缘 -->
    <path
        android:pathData="M46,49m-8,0a8,8 0 1,0 16,0a8,8 0 1,0 -16,0"
        android:strokeColor="#40C2945D"
        android:strokeWidth="1.0"
        android:fillColor="#00000000" />
    <!-- 鱼眼立体凸起内珠（球状光泽） -->
    <path
        android:pathData="M46,49m-4.2,0a4.2,4.2 0 1,0 8.4,0a4.2,4.2 0 1,0 -8.4,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="44.5"
                android:centerY="47.5"
                android:gradientRadius="4.2"
                android:type="radial">
                <item android:offset="0.0" android:color="#F4D399" />
                <item android:offset="0.4" android:color="#D6A75E" />
                <item android:offset="1.0" android:color="#5A3A22" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. 出音中缝深邃鸣槽（实体深凹缝隙，带倒角与内腔深邃感） -->
    <!-- 鸣槽外部倒角阴影 -->
    <path
        android:pathData="M106,63 L72,63 C63,63 63,81 72,81 L94,81 C100,81 104,74 104,67 Z"
        android:fillColor="#120904" />
    <!-- 鸣槽内腔极深黑色空洞 -->
    <path
        android:pathData="M105,65 L73,65 C66,65 66,79 73,79 L92,79 C97,79 101,74 101,69 Z"
        android:fillColor="#0A0502" />
    <!-- 鸣槽下唇受光边缘（实木高光倒角） -->
    <path
        android:pathData="M73,81 L94,81 C100,81 104,75 104,68"
        android:strokeColor="#4DC2945D"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 7. 木鱼实体鱼尾手柄（圆润实木把手，具独立圆柱光影） -->
    <path
        android:pathData="M26,73 C16,81 18,97 29,101 C37,104 45,99 47,93 C42,91 32,88 26,73 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="75"
                android:endX="42"
                android:endY="101"
                android:type="linear">
                <item android:offset="0.0" android:color="#4A2F1B" />
                <item android:offset="0.5" android:color="#361F10" />
                <item android:offset="1.0" android:color="#1F1108" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 鱼尾受光侧微高光 -->
    <path
        android:pathData="M23,78 C18,84 19,95 28,99"
        android:strokeColor="#33C2945D"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 8. 鱼身下腹立体阴影压暗（烘托整体实物厚重感） -->
    <path
        android:pathData="M38,98 C50,104 74,104 86,97 C76,102 52,102 38,98 Z"
        android:fillColor="#26000000" />
</vector>
